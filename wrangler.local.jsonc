{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "silverassist-portal",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "APP_ENV": "local",
    "AUTH_BASE_URL": "http://localhost:5173",
    "AUTH_ALLOWED_EMAILS": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "silverassist-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "MAIL_OUTBOX",
      "bucket_name": "silverassist-local-mail",
      "remote": false
    }
  ]
}
